# Configuración opcional para ejecutar el servidor local.
PORT=3000

# URL pública completa del Worker de precios. Configúrala solo si el Worker está habilitado.
VITE_PRICE_API_URL=

# Frontend de pruebas de R0. Los secretos de Stripe pertenecen solo al Worker.
VITE_BILLING_API_URL=
VITE_BILLING_FIREBASE_PROJECT_ID=
VITE_BILLING_FIREBASE_API_KEY=
# Solo para pruebas del registro en localhost.
VITE_BILLING_AUTH_EMULATOR_URL=
